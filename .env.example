# Server environment variables & security secrets
JWT_SECRET=
SYSTEM_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBHOOK_SECRET=
DOTFY_API_KEY=
DISCORD_AFFILIATE_WEBHOOK_URL=

# Server Firestore identity: workload credentials or a service account (never commit keys).
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Defaults disabled. These options never enable real-credit simulation in production.
ENABLE_DEMO_ADMIN=false
ALLOW_PAYMENT_SIMULATION=false
